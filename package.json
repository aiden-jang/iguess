{
  "name": "iguess",
  "version": "0.0.0",
  "private": true,
  "description": "Multiplayer draw-and-guess vs an AI player.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @iguess/game-server dev",
    "dev:ai": "pnpm --filter @iguess/ai-worker dev",
    "dev:client": "pnpm --filter @iguess/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --project tsconfig.tests.json",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx,.mjs,.cjs,.js --max-warnings 0",
    "check-size": "node scripts/check-size.mjs",
    "check-comments": "node scripts/check-comments.mjs",
    "check-tests": "node scripts/check-tests.mjs",
    "verify": "pnpm run security:check && pnpm typecheck && pnpm lint && pnpm run check-size && pnpm run check-comments && pnpm run check-tests && pnpm build",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "deploy": "pnpm run verify && pnpm run deploy:only",
    "deploy:only": "pnpm --filter @iguess/ai-worker run deploy && pnpm --filter @iguess/game-server run deploy",
    "security:check": "pnpm audit --audit-level=low"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
