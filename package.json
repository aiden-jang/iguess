{
  "name": "iguess",
  "version": "0.0.0",
  "private": true,
  "description": "Multiplayer draw-and-guess vs an AI player.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @iguess/game-server dev",
    "dev:ai": "pnpm --filter @iguess/ai-worker dev",
    "dev:client": "pnpm --filter @iguess/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "deploy": "pnpm typecheck && pnpm lint && pnpm test && pnpm run deploy:only",
    "deploy:only": "pnpm --filter @iguess/ai-worker run deploy && pnpm --filter @iguess/game-server run deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.9.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
