{
  "id": "/",
  "name": "iguess",
  "short_name": "iguess",
  "description": "Draw a secret word. Race your friends and an AI to guess it. Bad drawings welcome.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "categories": ["games", "entertainment", "social"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "background_color": "#f2f2e9",
  "theme_color": "#f2f2e9",
  "icons": [
    {
      "src": "/icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg?v=2",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Play the AI",
      "short_name": "vs AI",
      "description": "You draw, the AI races to guess it",
      "url": "/#mode=ai"
    },
    {
      "name": "Let the AI draw",
      "short_name": "AI draws",
      "description": "The AI draws, you guess",
      "url": "/#mode=ai-drawer"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/join-current.jpg",
      "sizes": "1440x1000",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Draw badly. Guess wildly."
    },
    {
      "src": "/screenshots/join-current-mobile.jpg",
      "sizes": "390x844",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Draw badly. Guess wildly."
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
