{
  "name": "@iguess/game-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var AI_WORKER_URL:http://localhost:33400",
    "deploy": "pnpm --filter @iguess/client build && pnpm run deploy:assets",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=tap \"src/**/*.test.ts\"",
    "deploy:assets": "wrangler deploy --var AI_WORKER_URL:https://iguess-ai.aidenjang.workers.dev"
  },
  "dependencies": {
    "@iguess/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
